[TEMPLATE]
# LLM API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DASHSCOPE_API_KEY=sk-...
# 万界数据中转站 https://www.wjark.com
WJ_API_KEY=...
WJ_BASE_URL=https://maas-openapi.wanjiedata.com/api/v1

# 默认模型配置
DEFAULT_MODEL=deepseek-v4-flash
# 创作类任务（写作/润色）在无显式指定模型时的默认模型
CREATIVE_MODEL=deepseek-v4-flash
# 分析类任务（评估/打分/诊断/规划）在无显式指定模型时的默认模型
ANALYTICAL_MODEL=deepseek-v4-flash
FAST_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-large

# 管理员账号（硬编码管理员，密码从环境变量读取）
ADMIN_USER_ID=admin
ADMIN_PASSWORD=admin

# 向量数据库
VECTOR_DB_PATH=./chroma_data

# Redis
REDIS_URL=redis://localhost:6379/0

# LangSmith 可观测性
LANGSMITH_API_KEY=ls-...
LANGSMITH_PROJECT=comedy-agent

# 素材搜索：RSS 新闻源列表（逗号分隔，无需 API Key）
# 默认包含 BBC、The Guardian、联合早报；可替换为新浪、网易、凤凰等中文源
NEWS_RSS_FEEDS=https://www.chinanews.com.cn/rss/scroll-news.xml,https://www.chinanews.com.cn/rss/china.xml,https://www.chinanews.com.cn/rss/world.xml,https://www.chinanews.com.cn/rss/finance.xml,https://www.ithome.com/rss/,https://36kr.com/feed,https://rss.mifaw.com/articles/5c8bb11a3c41f61efd36683e/5c919d543882afa09dff3fa3

# Anyway 支付（打赏）
# 在 https://app.anyway.sh Business 后台创建 product 后获得 Payment Link URL 与 Merchant API Key
ANYWAY_PAYMENT_LINK_URL=https://pay.anyway.sh/...
ANYWAY_MERCHANT_API_KEY=...
ANYWAY_WEBHOOK_SIGNING_KEY=...
ANYWAY_WEBHOOK_PATH=/webhooks/anyway
ANYWAY_FEE_PERCENT=5.0
ANYWAY_MIN_TIP_CENTS=100
ANYWAY_MAX_TIP_CENTS=1000000

# 阿里云 Workbench CLI（ECS 远程运维）
# 启用后，Agent 可通过 workbench 命令远程管理 ECS 实例（需先安装 workbench CLI 并配置凭证）
ECS_WORKBENCH_ENABLED=false
# Workbench CLI 多 Profile 名称（对应 ~/.workbench/config.json 中的 profile）
ECS_WORKBENCH_PROFILE=default
# 默认 ECS 地域
ECS_DEFAULT_REGION=cn-hangzhou
# 远程命令执行超时（秒）
ECS_EXEC_TIMEOUT=30

# Base 链加密货币打赏配置
# Base RPC 节点地址（可使用 Alchemy、Infura、QuickNode 等）
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# USDC 合约地址（Base 主网）
TIP_TOKEN_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# 代币精度，USDC 为 6
TIP_TOKEN_DECIMALS=6
# 链上确认区块数要求
TIP_CHAIN_CONFIRMATIONS=12
