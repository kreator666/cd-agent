# LLM API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DASHSCOPE_API_KEY=sk-...
# 万界数据中转站 https://www.wjark.com
WJ_API_KEY=...
WJ_BASE_URL=https://maas-openapi.wanjiedata.com/api/v1

# 默认模型配置
DEFAULT_MODEL=gpt-4o
DEFAULT_EMBEDDING_MODEL=text-embedding-3-large

# 向量数据库
VECTOR_DB_PATH=./chroma_data

# Redis
REDIS_URL=redis://localhost:6379/0

# LangSmith 可观测性
LANGSMITH_API_KEY=ls-...
LANGSMITH_PROJECT=comedy-agent

# 素材搜索（可选，用于 DuckDuckGo 不可用时的回退）
# Tavily API Key：https://tavily.com
TAVILY_API_KEY=tvly-...
# SearXNG 实例地址（自建或公共实例，例如 https://search.example.com）
SEARXNG_URL=
# Bing Web Search API Key（Azure 认知服务，国内可用）：https://portal.azure.com
BING_SEARCH_API_KEY=
# Bing Web Search API 端点（默认官方端点，自建代理时可修改）
# BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
# 强制指定素材搜索引擎（不配置则自动回退）：duckduckgo / searxng / bing / tavily / newsapi / rss
# MATERIAL_SEARCH_ENGINE=bing

# 新闻类数据源
# NewsAPI Key（免费版 100 次/天）：https://newsapi.org
NEWSAPI_API_KEY=
# RSS 订阅源列表（逗号分隔，无需 API Key）
# 默认包含 BBC、The Guardian、联合早报；可替换为新浪、网易、凤凰等中文源
NEWS_RSS_FEEDS=https://feeds.bbci.co.uk/news/rss.xml,https://www.theguardian.com/world/rss,https://www.zaobao.com.sg/rss.xml
